# Example unit for the stand (FIN-149): Go services under systemd, one PostgreSQL.
# Install as /etc/systemd/system/user.service.
# The deploy script runs "/opt/finassist/user/user migrate up" (same environment) before restarting the unit.
#
# Secrets are systemd credentials, not environment variables: they do not show up in
# "systemctl show" or /proc/<pid>/environ. DynamicUser cannot read root-owned 0600 files, so
# every private file below reaches the process only through LoadCredential (%d/<name>).
#   /etc/finassist/user/env                    non-secret settings (see docs/config.md); EnvironmentFile=
#                                              overrides Environment=, so it must not set what this unit sets
#   /etc/finassist/user/db-primary-dsn         DSN, mode 0600, owner root (LoadCredential)
#   /etc/finassist/user/jwt-signing.pem        user access JWT signing key, mode 0600, owner root (LoadCredential)
#   /etc/finassist/user/auth-idempotency.key   32 raw bytes AES-256, Register/Refresh replay, mode 0600,
#                                              owner root (LoadCredential); shared by replicas, kept >= 24h
#   /etc/finassist/user/phone-result.key       32 raw bytes AES-256, phone verification result, mode 0600,
#                                              owner root (LoadCredential); must differ from auth-idempotency.key
#   /etc/finassist/user/stage-signing.pem      stand signing key, mode 0600, owner root (LoadCredential)
#   /etc/finassist/stage-public.jwks           stand public JWKS shared by all services, mode 0644
#                                              (/etc/finassist 0755): DynamicUser reads it directly
#   /etc/finassist/user/zvonok-public-key      Zvonok API key, mode 0600, owner root (LoadCredential),
#                                              only when the commented Zvonok block below is enabled
# On tmpfs with ACL support systemd exposes a credential as 0440 (the ACL mask in the group bits);
# the service accepts 0400 and 0440 inside $CREDENTIALS_DIRECTORY and owner-only modes elsewhere.
#
# Every Environment= line here is the plain form NAME=value: no quotes, spaces, tabs or backslashes,
# no secret values (secrets only as *_FILE=%d/<credential>); internal/config/stand_unit_test.go checks it.
[Unit]
Description=fin-assist user
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/finassist/user/user serve
EnvironmentFile=/etc/finassist/user/env
Environment=ENV=stage
# SERVICE_NAME is the kid/sub of the stand signing key and must match its kid in the shared JWKS;
# it also names the service in logs, application_name and the caller name it presents.
Environment=SERVICE_NAME=user
LoadCredential=db-primary-dsn:/etc/finassist/user/db-primary-dsn
Environment=DB_PRIMARY_DSN_FILE=%d/db-primary-dsn
LoadCredential=jwt-signing:/etc/finassist/user/jwt-signing.pem
Environment=JWT_SIGNING_KEY_FILE=%d/jwt-signing
# The phone result AES-256 key must differ from the auth replay key; retain it for live results.
LoadCredential=phone-result:/etc/finassist/user/phone-result.key
Environment=PHONE_RESULT_KEY_FILE=%d/phone-result
# The auth replay AES-256 key is shared by replicas; retain it for 24h after the last write.
LoadCredential=auth-idempotency:/etc/finassist/user/auth-idempotency.key
Environment=AUTH_IDEMPOTENCY_KEY_FILE=%d/auth-idempotency
# env must set JWT_KEY_ID, JWT_ISSUER, JWT_AUDIENCE and AUTH_STAGE_ISSUER (FIN-325: identity follows ENV,
# the old SERVICE_AUTH_MODE/SERVICE_TOKEN_ISSUER/STAGE_*/KUBERNETES_* names refuse to start).
# Set PEER_BANK_STATEMENT_DATA_ADDR, PEER_ANALYTICS_ADDR and PEER_ASSISTANT_ADDR for the default outbox routes.
# With ENV=stage the service identity always uses file keys (FIN-325); env must also set AUTH_STAGE_ISSUER.
LoadCredential=stage-signing:/etc/finassist/user/stage-signing.pem
Environment=AUTH_STAGE_SIGNING_KEY_FILE=%d/stage-signing
Environment=AUTH_STAGE_PUBLIC_KEYS_FILE=/etc/finassist/stage-public.jwks
# ENV=prod (Kubernetes, AUTH_KUBERNETES_* and SERVICE_TOKEN_FILE) is not deployed by this unit.

# Real Zvonok is opt-in for the stand; keep disabled until campaign acceptance.
#LoadCredential=zvonok-public-key:/etc/finassist/user/zvonok-public-key
#Environment=PHONE_PROVIDER=zvonok
#Environment=ZVONOK_PUBLIC_KEY_FILE=%d/zvonok-public-key
#Environment=ZVONOK_CAMPAIGN_ID=<campaign ID>
#Environment=ZVONOK_CALLBACK_ADDR=127.0.0.1:9095
#Environment=ZVONOK_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Ingress: /callbacks/zvonok only, source 193.232.64.150, no query access logs.

DynamicUser=yes
Restart=on-failure
RestartSec=2s
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT (5s + 20s by default) plus a margin.
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
